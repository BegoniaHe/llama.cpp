{
	"name": "webui",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "bash scripts/dev.sh",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations",
		"build": "vite build && ./scripts/post-build.sh",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"reset": "rm -rf .svelte-kit node_modules",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "npm run test:ui -- --run && npm run test:client -- --run && npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:client": "vitest --project=client",
		"test:unit": "vitest --project=unit",
		"test:ui": "vitest --project=ui",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"cleanup": "rm -rf .svelte-kit build node_modules test-results"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.1.1",
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.4",
		"@inlang/paraglide-js": "^2.15.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^0.515.0",
		"@playwright/test": "^1.59.1",
		"@storybook/addon-a11y": "^10.3.4",
		"@storybook/addon-docs": "^10.3.4",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.3.4",
		"@storybook/sveltekit": "^10.3.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.56.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24.12.2",
		"@vitest/browser": "^3.2.4",
		"@vitest/coverage-v8": "^3.2.4",
		"bits-ui": "^2.16.5",
		"clsx": "^2.1.1",
		"dexie": "^4.4.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.3.4",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^16.5.0",
		"http-server": "^14.1.1",
		"@types/mdast": "^4.0.4",
		"mdsvex": "^0.12.7",
		"playwright": "^1.59.1",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"rehype-katex": "^7.0.1",
		"remark-math": "^6.0.0",
		"sass": "^1.99.0",
		"storybook": "^10.3.4",
		"svelte": "^5.55.1",
		"svelte-check": "^4.4.6",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.0",
		"unified": "^11.0.5",
		"uuid": "^13.0.0",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^0.2.1",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^0.1.0"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"highlight.js": "^11.11.1",
		"mode-watcher": "^1.1.0",
		"pdfjs-dist": "^5.6.205",
		"rehype-highlight": "^7.0.2",
		"rehype-stringify": "^10.0.1",
		"remark": "^15.0.1",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-html": "^16.0.1",
		"remark-rehype": "^11.1.2",
		"svelte-sonner": "^1.1.0",
		"unist-util-visit": "^5.1.0",
		"zod": "^4.3.6"
	}
}
